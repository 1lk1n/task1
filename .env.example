# Telegram bot (from @BotFather)
BOT_TOKEN=
# Telegram user ids allowed to create products, comma-separated (your id: @userinfobot)
ADMIN_IDS=
# Public HTTPS address of nginx: Telegram sends the webhook there and opens the Mini App from it.
# Locally: `cloudflared tunnel --url http://localhost:8080` and paste the https://… address here.
PUBLIC_URL=https://example.trycloudflare.com
# Letters, digits, _ and - only (Telegram's rule for webhook secrets)
WEBHOOK_SECRET=change-me-webhook-secret
# Shared secret the bot uses to create products through the API
SERVICE_TOKEN=change-me-service-token

POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog-password

MINIO_ROOT_USER=catalog
MINIO_ROOT_PASSWORD=catalog-minio-password

# Port nginx listens on, on this machine
HTTP_PORT=8080
